# Copy this file to .env for private live integration testing.
# Do not commit real iMessage handles or message text.

# Required for live integration tests only.
IMESSAGE_ENABLE_LIVE_TESTS=1
IMESSAGE_LIVE_ALLOW_SEND=1
IMESSAGE_LIVE_TO=alice@example.com

# Optional custom live-test message. Tests generate a unique message if omitted.
IMESSAGE_LIVE_MESSAGE=
